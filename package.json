{
  "name": "araw",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ARAW: AI Relevance Activities and Workshops",
  "license": "MIT",
  "scripts": {
    "dev": "vite --port 5173 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "vitest run --reporter=dot",
    "e2e": "playwright test --reporter=line",
    "budget": "node scripts/check-budget.mjs",
    "icons": "node scripts/make-icons.mjs",
    "verify": "npm run build && npm run budget && npm run test && npm run e2e"
  },
  "dependencies": {
    "@fontsource/baloo-2": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@fontsource/press-start-2p": "^5.3.0",
    "@preact/signals": "^2.11.3",
    "@wllama/wllama": "3.8.1",
    "@wllama/wllama-compat": "3.8.1",
    "pixelarticons": "^2.4.2",
    "preact": "^11.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.1",
    "@preact/preset-vite": "^2.10.6",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/preact": "^3.2.4",
    "@types/node": "^26.6.5",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
