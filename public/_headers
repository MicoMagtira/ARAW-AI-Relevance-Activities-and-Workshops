# Cloudflare Pages response headers (this file is not served to visitors).
# Hashed build files never change, so browsers may keep them for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The service worker and the app shell must always be checked for a new version.
/sw.js
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/
  Cache-Control: no-cache

# Cross-origin isolation lets the Chatbot Sandbox AI use several CPU threads (SharedArrayBuffer). "credentialless" still
# allows the model download from Hugging Face; browsers without it simply run the AI on one thread.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: credentialless
